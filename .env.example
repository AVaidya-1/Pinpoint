# Model hosts. Any one works; with several, Pinpoint races them and uses the
# first answer (free tiers queue unpredictably).
NVIDIA_API_KEY=          # build.nvidia.com: Gemma 4 31B, embeddings, Nemotron Parse OCR
GEMINI_API_KEY=          # aistudio.google.com: Gemma 4 26B (+ Gemini Flash last resort)
OPENROUTER_KEY=          # openrouter.ai: Gemma 4 31B

# Optional overrides
# EVIDENCE_PROVIDERS=nvidia,google,openrouter,google-flash
# EVIDENCE_NVIDIA_MODEL=google/gemma-4-31b-it
# EVIDENCE_MODEL=gemma-4-26b-a4b-it
# EVIDENCE_OPENROUTER_MODEL=google/gemma-4-31b-it:free
# EVIDENCE_DATA_DIR=./data
# EVIDENCE_MAX_UPLOAD_MB=2048   # 0 = no limit
# EVIDENCE_OCR=1
